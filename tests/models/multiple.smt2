(set-logic HORN)
(declare-fun nonnegative (Int) Bool)
(declare-fun positive (Int Int) Bool)
(declare-fun always (Int Bool) Bool)
(declare-fun never (Int) Bool)
(assert (nonnegative 0))
(assert (forall ((x Int)) (=> (nonnegative x) (nonnegative (+ x 1)))))
(assert (forall ((x Int)) (=> (nonnegative x) (positive x (+ x 1)))))
(assert (forall ((x Int)) (=> (and (nonnegative x) (< x 0)) false)))
(assert (forall ((x Int) (y Int)) (=> (and (positive x y) (< y 1)) false)))
(assert (forall ((x Int) (b Bool)) (always x b)))
(assert (forall ((x Int)) (=> (never x) false)))
(check-sat)
(get-model)
