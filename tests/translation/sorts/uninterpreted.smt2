; Arbitrary carriers, aliases, mixed functions, definitions, and bound scopes.
(set-logic ALL)
(declare-sort |Node (;)| 0)
(declare-sort Label 0)
(declare-sort Unused 0)
(define-sort NodeAlias () |Node (;)|)
(define-sort Id (T) T)
(declare-const a NodeAlias)
(declare-const b (Id |Node (;)|))
(declare-const flag Bool)
(declare-fun step (NodeAlias) NodeAlias)
(declare-fun tag (NodeAlias Bool Int) Label)
(declare-fun P (Label) Bool)
(define-fun choose ((x NodeAlias) (y NodeAlias) (q Bool)) NodeAlias (ite q x y))
(assert (= (choose a b flag) (ite flag a b)))
(assert (distinct a b (step a)))
(assert (forall ((x NodeAlias)) (exists ((y (Id NodeAlias))) (= y (step x)))))
(assert (let ((saved a)) (forall ((a NodeAlias)) (= saved b))))
(assert (forall ((x NodeAlias))
  (! (=> (= x a) (= (tag x flag 0) (tag a flag 0))) :pattern ((tag x flag 0)))))
(assert (! (P (tag (choose a b flag) flag 1)) :named marked))
(assert marked)
(check-sat)
