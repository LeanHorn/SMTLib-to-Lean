; Shift/rotation terms in Horn guards and relation arguments.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-fun P (Word) Bool)
(declare-fun R (Word Word Word) Bool)
(define-fun rotate ((x Word)) Word ((_ rotate_left 1) x))
(assert (P #x8))
(assert (forall ((x Word) (n Word))
  (=> (and (P x) (bvult n #x4))
      (R (bvshl x n) (bvlshr x n) (bvashr x n)))))
(assert (forall ((x Word) (y Word) (z Word))
  (=> (and (R x y z) (= (rotate x) ((_ rotate_right 3) x))) (P (rotate z)))))
(assert (forall ((x Word))
  (=> (and (P x) (distinct (bvshl x #xf) #x0)) false)))
(check-sat)
