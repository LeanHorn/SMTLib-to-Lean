; Conversions in relation arguments; every supported overflow predicate in guards.
(set-logic HORN)
(define-sort Word () (_ BitVec 8))
(declare-fun P (Word) Bool)
(declare-fun R (Int Int Bool) Bool)
(define-fun pack ((n Int)) Word ((_ int2bv 8) n))
(assert (P (pack (- 1))))
(assert (forall ((x Word) (y Word))
  (=> (and (P x) (bvuaddo x y) (not (bvsaddo x y)))
      (R (ubv_to_int x) (sbv_to_int y) (bvnego x)))))
(assert (forall ((n Int) (m Int) (b Bool))
  (=> (and (R n m b) (bvumulo (pack n) (pack m))) (P (pack (+ n m))))))
(assert (forall ((x Word) (y Word))
  (=> (and (P x) (bvsmulo x y) (bvusubo x y) (not (bvssubo x y)) (bvsdivo x y)) false)))
(check-sat)
