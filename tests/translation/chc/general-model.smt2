; General relation constraints: existential, disjunctive, and negative occurrences.
(set-logic HORN)
(declare-const c Int)
(declare-fun P (Int) Bool)
(declare-fun Q (Int) Bool)
(define-fun inhabited () Bool (exists ((x Int)) (P x)))
(assert inhabited)
(assert (forall ((x Int)) (or (P x) (Q x))))
(assert (forall ((x Int)) (not (and (P x) (Q x)))))
(check-sat)
(push 1)
(assert (forall ((x Int)) (not (P x))))
(check-sat)
(pop 1)
(check-sat)
