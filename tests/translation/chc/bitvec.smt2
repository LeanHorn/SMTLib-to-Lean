; Width-indexed Horn arguments, modular arithmetic, guards, and one-bit comparison.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-sort Node 0)
(declare-fun P (Node Word) Bool)
(declare-fun R (Node Word (_ BitVec 1) Bool) Bool)
(define-fun bump ((x Word)) Word (bvadd x #x1))
(assert (forall ((a Node)) (P a #x0)))
(assert (forall ((a Node) (x Word) (b Bool))
  (=> (and (P a x) (bvult x #xf) (bvsge x #x0))
      (R a (ite b (bump x) (bvnot x)) (bvcomp x #xf) b))))
(assert (forall ((a Node) (x Word) (bit (_ BitVec 1)) (b Bool))
  (=> (and (R a x bit b) (= bit #b0) (distinct x #x0)) (P a (bvand x #xe)))))
(assert (forall ((a Node) (x Word))
  (=> (and (P a x) (bvult x #x0)) false)))
(check-sat)
