; Relations over two arbitrary carriers, with Bool/Int arguments and theory guards.
(set-logic HORN)
(declare-sort Node 0)
(declare-sort Label 0)
(define-sort N () Node)
(declare-fun Reach (N) Bool)
(declare-fun Edge (N Label Bool Int) Bool)
(declare-fun unused (Label) Bool)
(define-fun same ((x N) (y N)) Bool (= x y))
(assert (forall ((x N)) (Reach x)))
(assert (forall ((x N) (y N) (l Label) (b Bool) (i Int))
  (=> (and (Reach x) (same x y) b (> i 0)) (Edge (ite b x y) l b i))))
(assert (forall ((x N) (y N) (l Label) (b Bool) (i Int))
  (=> (and (Edge x l b i) (distinct x y)) (Reach y))))
(assert (forall ((x N) (y N)) (=> (and (Reach x) (Reach y) (distinct x y)) false)))
(check-sat)
