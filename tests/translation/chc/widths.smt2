; Relations over different widths, with slices/extensions in guards and arguments.
(set-logic HORN)
(define-sort Nibble () (_ BitVec 4))
(define-sort Byte () (_ BitVec 8))
(declare-fun P (Nibble) Bool)
(declare-fun R (Byte Byte Byte) Bool)
(define-fun low ((x Byte)) Nibble ((_ extract 3 0) x))
(assert (P #xf))
(assert (forall ((x Nibble))
  (=> (and (P x) (= ((_ extract 3 3) x) #b1))
      (R ((_ zero_extend 4) x) ((_ sign_extend 4) x) ((_ repeat 2) x)))))
(assert (forall ((x Byte) (y Byte) (z Byte))
  (=> (and (R x y z) (= z (concat (low z) (low z)))) (P (low y)))))
(assert (forall ((x Byte) (y Byte) (z Byte))
  (=> (and (R x y z) (distinct (low x) (low y))) false)))
(check-sat)
