; Mixed Int/Real arguments, floor guards, integrality, and shared zero interpretations.
(set-logic HORN)
(declare-sort Node 0)
(declare-fun P (Node Int Real) Bool)
(declare-fun R (Node Real Int Bool) Bool)
(define-fun down ((x Real)) Int (to_int x))
(assert (forall ((a Node) (i Int)) (P a i (to_real i))))
(assert (forall ((a Node) (i Int) (x Real) (b Bool))
  (=> (and (P a i x) (< i x) (is_int x))
      (R a (+ i x) (down (/ x 0.0)) b))))
(assert (forall ((a Node) (x Real) (i Int) (b Bool))
  (=> (and (R a x i b) (not (= i (down x)))
           (= (to_real (div i 0)) (/ x 0.0))) false)))
(check-sat)
