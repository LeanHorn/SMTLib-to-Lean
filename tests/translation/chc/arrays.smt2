(set-logic HORN)
(declare-fun R ((Array Int Int) Int) Bool)
(declare-fun Rows ((Array Int (Array Int Int))) Bool)
(assert (forall ((a (Array Int Int))) (R a 0)))
(assert (forall ((a (Array Int Int)) (i Int)) (=> (R a i) (R (store a i i) (+ i 1)))))
(assert (forall ((a (Array Int Int)) (i Int)) (=> (and (R a i) (distinct (select (store a i i) i) i)) false)))
(assert (forall ((a (Array Int (Array Int Int)))) (Rows a)))
(assert (forall ((a (Array Int (Array Int Int))) (r (Array Int Int))) (=> (Rows a) (Rows (store a 0 r)))))
(check-sat)
