; Only P and R are unknown relations. Helpers expand before Horn validation.
(set-logic HORN)
(define-sort I () Int)
(define-sort Id (T) T)
(define-sort B () (Id Bool))
(declare-fun P (I) B)
(declare-fun R ((Id I) B) B)
(define-fun zero () I 0)
(define-fun initial () B (P zero))
(define-fun inc ((x I)) I (+ x 1))
(define-fun premise ((x I)) B (and (P x) (> x zero)))
(define-fun head ((x I) (b B)) B (R (ite b (inc x) x) b))
(define-fun rule ((x I) (b B)) B
  (let ((enabled (premise x))) (=> enabled (head x b))))
(define-fun bad ((x I) (b B)) B (and (R x b) (> x 10) b))
(assert (! initial :named |entry clause|))
(assert (! (forall ((x I) (b (Id B))) (=> |entry clause| (rule x b))) :named step))
(assert (! (forall ((x I) (b B)) (=> (bad x b) false)) :named safety))
(check-sat)
