; Distinct ground instances, aliases, nested applications and quantified-only sorts.
(set-logic ALL)
(declare-sort Box 1)
(define-sort Wrapped (T) (Box T))
(declare-const x (Box Int))
(declare-const y (Wrapped Int))
(declare-const b (Box Bool))
(declare-fun wrap ((Box Int)) (Box (Box Int)))
(define-fun-rec identity ((v (Wrapped Int))) (Box Int) v)
(assert (= x y))
(assert (not (= (identity x) y)))
(assert (forall ((r (Box Real))) (= r r)))
(check-sat)
(push 1)
(declare-sort Local 2)
(declare-const z (Local Int Bool))
(check-sat)
(pop 1)
(check-sat)
(reset-assertions)
(declare-sort Box 2)
(check-sat-assuming ((forall ((v (Box Int Bool))) (= v v))))
(reset)
(set-logic ALL)
(check-sat)
