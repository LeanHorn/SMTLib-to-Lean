; Unused recursive equations constrain models and follow declaration lifetimes.
(set-logic ALL)
(check-sat)
(push 1)
(define-fun-rec bad () Int (+ bad 1))
(check-sat)
(pop 1)
(check-sat)
(define-fun-rec identity ((n Int)) Int (identity n))
(reset-assertions)
(check-sat)
(reset)
(set-option :global-declarations true)
(set-logic ALL)
(push 1)
(define-funs-rec ((f () Int) (g () Int)) ((+ g 1) f))
(pop 1)
(check-sat)
(reset-assertions)
(check-sat)
(reset)
(set-logic ALL)
(check-sat)
