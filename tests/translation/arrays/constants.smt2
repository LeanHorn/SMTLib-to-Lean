(set-logic ALL)
(define-sort Arr () (Array Int Int))
(define-fun zero () Arr ((as const Arr) 0))
(declare-const i Int)
(declare-const j Int)
(declare-const v Int)
(define-fun fill ((v Int)) Arr ((as const Arr) v))
(assert (= (select zero i) 0))
(assert (= (select (store zero i 7) i) 7))
(assert (=> (distinct i j) (= (select (store zero i 7) j) 0)))
(assert (distinct zero ((as const Arr) 1)))
(assert (= (select (select ((as const (Array Bool Arr)) ((as const Arr) 2)) true) i) 2))
(assert (= (select ((as const (Array Bool Bool)) false) true) false))
(assert (= (select ((as const (Array Int (_ BitVec 8))) #xff) i) #xff))
(assert (forall ((a Arr)) (= (select (store a i (select zero i)) i) 0)))
(assert (= (select (fill (+ v 1)) i) (+ v 1)))
(assert (let ((v (+ v 2))) (= (select ((as const Arr) v) j) v)))
(assert (forall ((v Int)) (= (select ((as const Arr) v) i) v)))
(assert (= (select ((as const Arr) (! v :named payload)) i) payload))
(assert (= (select ((as const (Array Int Arr)) (fill v)) i) (fill v)))
(check-sat)
