(set-logic ALL)
(declare-sort Key 0)
(define-sort Row () (Array Key Bool))
(declare-const row Row)
(declare-const k Key)
(declare-const a (Array Row (Array Int Row)))
(declare-const bits (Array (_ BitVec 8) Real))
(assert (= (select (store row k true) k) true))
(assert (= (select (select (store a row (select a row)) row) 0) (select (select a row) 0)))
(assert (= (select (store bits #xff 1.5) #xff) 1.5))
(assert (forall ((a (Array Row Int))) (exists ((b (Array Row Int))) (= a b))))
(assert (forall ((a (Array Int Int))) (exists ((b (Array Int Int))) (= a b))))
(check-sat)
