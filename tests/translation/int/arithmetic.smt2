; Arithmetic, nested abs, exact values, and all four comparison chains in one query.
(set-logic QF_NIA)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const p Bool)
(assert (= (+ x y z 7) (- x y z)))
(assert (= (* x y z) (* x (- y))))
(assert (= (- (- x)) x))
(assert (=> p (= (abs (- x)) (abs x))))
(assert (= (abs (abs x)) (abs x)))
(assert (and (= (abs (- 7)) 7) (= (abs 0) 0) (= (abs 9) 9)))
(assert (= (+ 340282366920938463463374607431768211457 (- 1))
           340282366920938463463374607431768211456))
(assert (= (- 10 3 2) 5))
; Pairwise inequality, including a repeated nonadjacent operand.
(assert (distinct x y))
(assert (distinct x y z 7))
(assert (not (distinct x y x)))
(assert (=> p (and (< x y z (+ x 1))
                   (<= x y z (+ x 2))
                   (> x y z (- x 1))
                   (>= x y z (- x 2)))))
(check-sat)
(exit)
