; Exact Euclidean arithmetic and shared zero-case interpretations.
(set-logic ALL)
(declare-const x Int)
(declare-const y Int)
(declare-const flag Bool)
(declare-fun f (Int) Int)
; These names must not capture the translator's arithmetic interpretations.
(declare-fun |SMT.divZero| (Int) Int)
(declare-fun |SMT.modZero| (Int) Int)
(define-fun quotient ((a Int) (b Int)) Int (div a b))
(define-fun residue ((a Int) (b Int)) Int (mod a b))
(assert (= (div (- 5) 2) (- 3)))
(assert (= (div 5 (- 2)) (- 2)))
(assert (= (mod (- 5) (- 2)) 1))
(assert (= (div 100 3 (- 2)) (- 16)))
(assert (= (let ((half (quotient x y))) (residue half y)) (mod (div x y) y)))
(assert (= (quotient x 0) (quotient (+ x 0) 0)))
(assert (= (residue x 0) (residue (+ x 0) 0)))
(assert (= (div (div x 0) 0) (f (mod x 0))))
(assert (forall ((x Int)) (exists ((y Int)) (= (quotient x y) (residue x y)))))
(assert (= (ite flag (div x y) (mod x y)) (f (div x 2))))
(assert (= (|SMT.divZero| x) (|SMT.modZero| x)))
(check-sat)
