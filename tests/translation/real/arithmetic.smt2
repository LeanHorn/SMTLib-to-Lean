; Exact Real arithmetic, functions, bindings, carriers, and shared zero cases.
(set-logic ALL)
(declare-sort Node 0)
(define-sort R () Real)
(declare-const x R)
(declare-const y Real)
(declare-const flag Bool)
(declare-const i Int)
(declare-const node Node)
(declare-fun f (Real) Real)
(declare-fun g (Real Bool Int Node) Real)
(declare-fun |SMT.realDivZero| (Real) Real)
(define-fun third () R (/ 1.0 3.0))
(define-fun ratio ((a R) (b R)) R (/ a b))
(assert (= (+ 0.1 0.2) 0.3))
(assert (and (<= x y 3.0) (< x y 4.0) (>= y x 0.0) (> y x (- 1.0))))
(assert (distinct x y third))
(assert (= (ite flag x y) (f third)))
(assert (let ((x (+ x 0.5)) (saved x)) (= (- x saved) 0.5)))
(assert (forall ((x Real)) (exists ((y Real)) (= (ratio x 0.0) (ratio y 0.0)))))
(assert (= (ratio x y) (f (+ x 0.1))))
(assert (= (/ x 0.0) (/ (+ x 0.0) (- 0.0))))
(assert (= (|SMT.realDivZero| x) (/ x 0.0)))
(assert (= (g x flag i node) (f x)))
; The same native Int numeral can also occur at a Real expected type.
(assert (and (= (+ x 1) (+ x 1.0)) (= (+ i 1) i)))
; This existential ranges over reals, including irrational values.
(assert (exists ((root Real)) (= (* root root) 2.0)))
(check-sat)
