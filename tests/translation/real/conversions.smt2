; Explicit/implicit casts, floor, integrality, shared terms, definitions, and binders.
(set-logic ALL)
(define-sort Amount () Real)
(declare-const i Int)
(declare-const x Amount)
(declare-const flag Bool)
(declare-fun f (Real) Int)
(define-fun down ((r Real)) Int (to_int r))
(define-fun shift ((n Int)) Real (+ (to_real n) 0.5))
(assert (= (to_real (+ i 1)) (+ i 1.0)))
(assert (and (< i x) (<= x i) (> (+ i 1) x) (>= x (- i 1))))
(assert (= (/ i 2) (- (* i x) i)))
; The same native Int term must remain Int outside the Real context.
(assert (and (= (+ i 1) (down x)) (= (+ (+ i 1) x) (shift i))))
(assert (and (= (to_int (- 1.7)) (- 2)) (= (to_int (- 2.0)) (- 2))))
(assert (= (is_int x) (= x (to_real (down x)))))
(assert (= (to_int (to_real i)) i))
(assert (and (= (to_int i) i) (is_int i)))
(assert (= (ite flag (down x) i) (f (to_real i))))
(assert (let ((i (down x)) (x (shift i))) (= (to_real i) x)))
(assert (forall ((i Int) (x Real))
  (exists ((i Real)) (and (= i (to_real (down x))) (is_int i)))))
(assert (and (= (to_real (div i 0)) (/ i 0))
             (= (to_int (/ x 0.0)) (mod i 0))))
(check-sat)
