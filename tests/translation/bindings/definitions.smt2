; Aliases resolve to existing sorts; definitions add no free parameters.
(set-logic UFLIA)
(define-sort I () Int)
(define-sort B () Bool)
(define-sort |Id sort| (T) T)
(define-sort First (T U) T)
(define-sort I2 () (First (|Id sort| I) B))
(declare-const x I2)
(declare-const p (|Id sort| B))
(declare-fun f (I2) I)
(define-fun |one value| () I2 1)
(define-fun next () I (+ x |one value|))
(define-fun saved () B p)
(define-fun inc ((x I2)) I2 (+ x |one value|))
(define-fun choose ((b B) (x I2) (y I)) I
  (let ((next (inc x))) (ite b next y)))
(define-fun guard ((x I)) B (and saved (> x next)))
(define-fun capture ((x I)) B (exists ((y I)) (= x y)))
(define-fun both ((p B)) B (forall ((q B)) (= p q)))
(assert (= next (+ x 1)))
(define-fun chained () I (inc next))
(define-fun unused ((ignored I)) I (f next))
(assert (= chained (f x)))
(assert (= (choose p (inc x) next) (ite p (+ (+ x 1) 1) (+ x 1))))
; Definitions retain the global x/p despite caller-side shadowing.
(assert (forall ((x I2) (p B)) (= (guard x) (and saved (> x next)))))
(assert (let ((x 99) (p false)) (= (choose p x next) next)))
; A definition's quantifier must not capture a caller's same-named variable.
(assert (forall ((y I)) (capture y)))
(assert (forall ((q B)) (both q)))
; Repeated/nested calls and declarations following definitions.
(declare-const later I)
(assert (= (inc (inc later)) (+ (inc later) 1)))
(check-sat)
