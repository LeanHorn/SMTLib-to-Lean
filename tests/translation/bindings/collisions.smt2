; User constructor/function names retain their meanings despite native builtins.
(set-logic ALL)
(declare-datatype flag ((true) (false)))
(define-sort Flag () flag)
(define-sort Truth () Bool)
(declare-fun set.card (Int) Int)
(declare-const x flag)
(assert (= (set.card 0) (- 1)))
(assert (= (|set.card| 1) (- 2)))
(assert (= (as true Truth) true))
(assert (= (as false Truth) false))
(assert (= (match (as true Flag) ((true 7) (false 9))) 7))
(assert ((_ is true) (as true flag)))
(assert (not ((_ is false) (as true flag))))
(assert (= x (as false flag)))
(assert true)
(check-sat)
; The first query has a model; distinct datatype constructors cannot be equal.
(assert (= (as true flag) (as false flag)))
(check-sat)
