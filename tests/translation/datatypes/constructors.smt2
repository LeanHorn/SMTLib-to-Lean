; Enums, records, recursive/mutual groups, binders, definitions, and arrays.
(set-logic ALL)
(declare-sort U 0)
(declare-datatype Color ((red) (blue)))
(declare-datatype Counter ((zero) (step (previous Counter))))
(declare-datatype Packet ((packet (flag Bool) (count Int) (tag U) (bits (_ BitVec 8)))))
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf (value Int)) (node (children Forest)))
   ((empty) (cons (first Tree) (rest Forest)))))
(declare-datatype Box ((box (contents (Array Color Counter)))))
(declare-datatype |Name-x| ((|rec|) (|match x| (value Int))))
(declare-datatype |Name x| ((|rec|)))
(declare-fun wrap (Counter) Counter)
(define-fun twice ((n Counter)) Counter (step (step n)))
(declare-const u U)
(declare-const n Counter)
(declare-const a (Array Color Counter))
(declare-const b Box)
(declare-const boxes (Array Box Tree))
(assert (= (twice zero) (let ((x (step zero))) (step x))))
(assert (= (wrap (ite true zero n)) (wrap zero)))
(assert (forall ((p Bool) (i Int)) (= (packet p i u #x2a) (packet p i u #x2a))))
(assert (forall ((t Tree)) (exists ((ts Forest)) (= ts (cons t empty)))))
(assert (= b (box a)))
(assert (= (select (store boxes (box a) (node (cons (leaf 7) empty))) (box a))
           (node (cons (leaf 7) empty))))
(assert (= (select ((as const (Array Color Counter)) (step n)) red) (step n)))
(assert (distinct (as |rec| |Name-x|) (|match x| 7)))
(assert (= (as |rec| |Name x|) (as |rec| |Name x|)))
(assert (distinct red blue))
(assert (= red blue))
(check-sat)
