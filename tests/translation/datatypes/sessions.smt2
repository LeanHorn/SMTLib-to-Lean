; Local/global declarations, earlier definitions, same-name redeclarations, and resets.
(set-logic ALL)
(declare-datatype D ((a) (b)))
(define-fun saved () D a)
(assert (= saved a))
(check-sat)
(push 1)
(declare-datatype Local ((local (value D))))
(assert (= (local saved) (local a)))
(assert (= (value (local saved)) a))
(check-sat)
(pop 1)
(push 1)
(declare-datatype Local ((local (value Int))))
(assert (= (local 7) (local 7)))
(assert (= (value (local 7)) 7))
(check-sat)
(pop 1)
(check-sat)
(reset-assertions)
(declare-datatype D ((a (next Int)) (b)))
(assert (= (a 9) (a 9)))
(assert (= (next b) (next b)))
(check-sat)
(reset)
(set-option :global-declarations true)
(set-logic ALL)
(push 1)
(declare-datatype D ((a) (b (field Int))))
(define-sort Alias () D)
(declare-const array (Array Alias Alias))
(pop 1)
(assert (= (select ((as const (Array Alias Alias)) a) (b 0)) a))
(assert (= (field a) (field a)))
(check-sat)
(reset-assertions)
(assert (= (select (store array a (b 1)) a) (b 1)))
(assert (= (field a) (field a)))
(check-sat)
(reset)
(set-logic QF_DT)
(declare-datatype D ((a) (b)))
(assert (distinct a b))
(check-sat)
(reset)
(set-logic ALL)
(declare-datatype D ((|const| (value Int))))
(assert (= ((as |const| D) 7) (|const| 7)))
(check-sat)
(reset)
(set-logic ALL)
; A user selector named const must not trigger constant-array rewriting.
(declare-datatype D ((box (|const| (Array Int Int))) (empty)))
(declare-const d D)
(assert (= (select (|const| d) 0) (select (|const| d) 0)))
(check-sat)
