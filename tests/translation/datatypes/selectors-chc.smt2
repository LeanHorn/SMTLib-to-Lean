; Selectors in Horn guards/arguments, recursive fields, arrays, and mutual groups.
(set-logic HORN)
(declare-datatype D ((has (field Int)) (other (tag Int))))
(declare-datatype List ((nil) (cons (head Int) (tail List))))
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf (value Int)) (node (children Forest)))
   ((empty) (trees (first Tree) (rest Forest)))))
(declare-datatype Box ((box (contents (Array Int List))) (unboxed)))
(declare-fun R (Int) Bool)
(declare-fun Reach (List) Bool)
(declare-fun Seen (Tree Forest) Bool)
(declare-fun Stored ((Array Int List) List) Bool)
(assert (R (field (has 7))))
(assert (=> (= (field (other 1)) (field (other 2))) false))
(assert (Reach nil))
(assert (forall ((xs List)) (=> (Reach xs) (Reach (tail xs)))))
(assert (forall ((xs List)) (=> (Reach xs) (R (head xs)))))
(assert (forall ((t Tree) (f Forest)) (Seen (first f) (children t))))
(assert (forall ((b Box)) (Stored (contents b) (select (contents b) 0))))
(check-sat)
