; Testers, first-match priority, branch-local bindings, and every supported result sort.
(set-logic ALL)
(declare-sort U 0)
(declare-const u U)
(declare-datatype D ((zero) (pair (left Int) (right Int)) (link (next D))))
(declare-datatype Box ((box (item U))))
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf (value Int)) (node (children Forest)))
   ((empty) (trees (first Tree) (rest Forest)))))
(declare-const d D)
(declare-const x Int)
(declare-fun f (Int D) Int)
(define-fun get ((v D) (offset Int)) Int
  (match v ((zero offset) ((pair offset y) (+ offset y)) ((link v) offset))))
(assert (and ((_ is zero) zero) (is-pair (pair 1 2)) (not ((_ is pair) (link zero)))
  ((_ is box) (box u)) ((_ is node) (node empty)) (is-empty empty)))
(assert (= (get zero x) x))
(assert (= (get (pair 1 2) x) 3))
(assert (forall ((offset Int)) (= (get (pair offset 1) offset) (+ offset 1))))
(assert (= (match d ((whole whole))) d))
; Duplicate constructors and early catch-alls must select the first branch.
(assert (= (match (pair 1 2) (((pair x y) x) ((pair x y) y) (whole 99))) 1))
(assert (= (match (pair 1 2) ((whole whole) ((pair x y) zero))) (pair 1 2)))
(assert (= (match zero ((z 1) (w 2))) 1))
(assert (forall ((x Int))
  (match d ((zero (= x x)) ((pair x y) (forall ((x Int)) (= x x)))
            ((link d) (= (match d ((z z))) d))))))
(assert (= (f (match d ((zero x) ((pair x y) (+ x y)) ((link d) x))) d)
           (f (get d x) d)))
(assert (= (match (box u) (((box u) u))) u))
(assert (= (match (link zero) (((link v) #x03) (z #x04))) #x03))
(assert (= (match zero ((zero 1.5) (z 2.5))) 1.5))
(assert (= (select (match (pair 2 3)
  (((pair x y) ((as const (Array Int Int)) (+ x y)))
   (z ((as const (Array Int Int)) 0)))) 8) 5))
(assert (= (match (node (trees (leaf 7) empty))
  (((leaf x) x) ((node f) (match f (((trees t rest)
    (match t (((leaf x) x) ((node f) 0)))) (empty 0)))))) 7))
(check-sat)
