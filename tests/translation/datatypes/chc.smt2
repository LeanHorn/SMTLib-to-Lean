; Datatype constructors in facts, guards, and recursive Horn relation arguments.
(set-logic HORN)
(declare-datatype Counter ((zero) (step (previous Counter))))
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf (value Int)) (node (children Forest)))
   ((empty) (cons (first Tree) (rest Forest)))))
(declare-fun Reach (Counter) Bool)
(declare-fun Seen (Tree Forest) Bool)
(declare-fun Stored ((Array Int Counter) Counter) Bool)
(assert (Reach zero))
(assert (forall ((n Counter)) (=> (Reach n) (Reach (step n)))))
(assert (forall ((n Counter)) (=> (and (Reach n) (= n (step n))) false)))
(assert (Seen (node (cons (leaf 1) empty)) empty))
(assert (forall ((a (Array Int Counter)) (n Counter))
  (Stored (store a 0 n) n)))
(check-sat)
