; Projections, shared wrong-constructor choices, and composition with supported sorts.
(set-logic ALL)
(declare-sort U 0)
(declare-const u U)
(declare-datatype D ((has (field Int)) (other (tag Int))))
(declare-datatype Record ((record (flag Bool) (number Real) (bits (_ BitVec 8)) (item U))))
(declare-datatype List ((nil) (cons (head Int) (tail List))))
(declare-datatypes ((Tree 0) (Forest 0))
  (((leaf (value Int)) (node (children Forest)))
   ((empty) (trees (first Tree) (rest Forest)))))
(declare-datatype Box ((box (contents (Array Int List))) (unboxed)))
(declare-datatype |Name-x| ((one (|field-x| Int)) (nothing)))
(declare-datatype |Name x| ((two (|field x| Int)) (absent)))
(declare-fun f (Int) Int)
(define-fun get ((d D)) Int (let ((v (field d))) (f v)))
(assert (= (field (has 7)) 7))
(assert (distinct (field (other 1)) (field (other 2))))
(assert (= (tag (has 0)) (tag (has 0))))
(assert (= (get (has 7)) (f 7)))
(assert (forall ((d D)) (exists ((x Int)) (= x (field d)))))
(assert (forall ((d D) (e D)) (=> (= d e) (= (field d) (field e)))))
(assert (and (flag (record true 1.5 #x03 u))
             (= (number (record true 1.5 #x03 u)) 1.5)
             (= (bits (record true 1.5 #x03 u)) #x03)
             (= (item (record true 1.5 #x03 u)) u)))
(assert (= (head (tail (cons 1 (cons 2 nil)))) 2))
(assert (= (tail nil) (tail nil)))
(assert (= (value (first (children (node (trees (leaf 9) empty))))) 9))
(assert (= (rest empty) (rest empty)))
(assert (= (select (contents (box ((as const (Array Int List)) (cons 3 nil)))) 0)
           (cons 3 nil)))
(assert (= (select (contents unboxed) 0) (select (contents unboxed) 0)))
(assert (= (select ((as const (Array D Int)) (field (other 1))) (has 0))
           (field (other 1))))
(assert (= (|field-x| nothing) (|field-x| nothing)))
(assert (= (|field x| absent) (|field x| absent)))
(check-sat)
