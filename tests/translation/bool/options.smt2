; Solver configuration does not change the contradiction p and (not p).
(set-info :smt-lib-version 2.6)
(set-option :print-success true)
(set-option :produce-models true)
(set-option :produce-proofs true)
(set-option :produce-unsat-cores true)
(set-option :random-seed 1234567890123456789012345678901234567890)
(set-info :source |Configuration example; (check-sat) here is just text.|)
(set-info :category "crafted")
(set-info :license "MIT")
(set-info :notes "Configuration with a doubled quote: ""true""")
(set-info :status unknown)
(set-logic QF_UF)
(declare-const p Bool)
(assert p)
; Configuration is recorded even between assertions, without touching the solver.
(set-option :produce-models false)
(set-option :produce-proofs false)
(set-option :produce-unsat-cores false)
(set-option ; preserve comments and whitespace in the original command
  :print-success false)
(set-option :random-seed 0)
(assert (not p))
(check-sat)
(set-info :status unsat)
(exit)
