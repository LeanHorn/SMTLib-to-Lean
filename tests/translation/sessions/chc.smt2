; Six checks; popped relations and clauses must leave no existential parameters.
(set-logic HORN)
(define-sort I () Int)
(declare-fun P (I) Bool)
(assert (P 0))
(check-sat)

(push 1)
(define-fun next ((x I)) I (+ x 1))
(declare-fun R (I Bool) Bool)
(assert (! (forall ((x I))
  (=> (and (P x) (> x 0)) (R (next x) true))) :named step))
(check-sat)

(push 1)
(declare-const done Bool)
(assert (forall ((x I)) (! (=> (R x true) done) :pattern ((R x true)) :qid finish)))
(check-sat)
(pop 2)
(check-sat)

(push 1)
(define-sort B () Bool)
(declare-fun R (B) Bool)
(define-fun enabled ((b B)) B b)
(assert (! (forall ((b B)) (=> (enabled b) (R b))) :named step))
(check-sat)
(pop 1)
(check-sat)
(exit)
