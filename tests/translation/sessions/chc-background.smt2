; Shared interpretations, scoped definitions/lets, quantified guards, and resets.
(set-logic HORN)
(declare-const c Int)
(declare-fun f (Int) Int)
(declare-fun P (Int) Bool)
(assert (P (f c)))
(check-sat)

(push 1)
(declare-const k Int)
(define-fun step ((n Int)) Int (let ((saved n)) (f (+ saved c))))
(define-fun good ((n Int)) Bool (exists ((c Int)) (= (step c) n)))
(assert (forall ((x Int)) (=> (good x) (P (step x)))))
(check-sat-assuming ((P k)))
(pop 1)
(check-sat)

(reset-assertions)
(declare-const c (_ BitVec 8))
(declare-fun f ((_ BitVec 8)) (_ BitVec 8))
(declare-fun P ((_ BitVec 8)) Bool)
(define-fun risky ((x (_ BitVec 8))) Bool (bvsdivo (f x) #xff))
(assert (forall ((x (_ BitVec 8))) (=> (risky x) (P c))))
(check-sat)

(reset)
(set-option :global-declarations true)
(set-logic HORN)
(push 1)
(declare-const c Int)
(declare-fun f (Int) Int)
(declare-fun P (Int) Bool)
(define-fun step ((n Int)) Int (f (+ n c)))
(pop 1)
(check-sat-assuming ((P (step c))))
(reset-assertions)
(check-sat)
(reset)
(set-logic HORN)
(check-sat)
