; Local declarations disappear on reset-assertions; global definitions survive it.
(set-logic ALL)
(declare-const p Bool)
(assert p)
(push 2)
(declare-const x Int)
(define-fun inc () Int (+ x 1))
(assert (> inc 0))
(check-sat-assuming (p))
(reset-assertions)
(check-sat)
(declare-const p Int)
(assert (= p 1))
(check-sat)
(reset)
(set-option :global-declarations true)
(set-logic ALL)
(push 1)
(declare-const p Bool)
(define-fun neg () Bool (not p))
(define-sort I () Int)
(assert p)
(pop 1)
(assert neg)
(check-sat)
(get-model)
(get-value (p neg))
(reset-assertions)
(check-sat)
(declare-const x I)
(assert neg)
(check-sat)
(get-proof)
(get-info :name)
(reset)
(set-logic ALL)
(push 1)
(declare-const p Bool)
(pop 1)
(check-sat)
(get-assertions)
