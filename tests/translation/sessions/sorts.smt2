; Sort identity, aliases, scope rollback, and both reset modes.
(set-logic ALL)
(declare-sort S 0)
(define-sort Alias () S)
(declare-const x Alias)
(assert (= x x))
(check-sat)
(push 1)
(declare-sort T 0)
(declare-const y T)
(assert (= y y))
(check-sat)
(pop 1)
(check-sat)
(push 1)
(declare-sort T 0)
(declare-fun p (T) Bool)
(assert (forall ((t T)) (p t)))
(check-sat)
(reset-assertions)
(declare-sort S 0)
(assert (forall ((s S)) false))
(check-sat)
(reset)
(set-option :global-declarations true)
(set-logic ALL)
(push 1)
(declare-sort S 0)
(define-sort Alias () S)
(define-fun id ((s Alias)) Alias s)
(pop 1)
(assert (forall ((s Alias)) (= (id s) s)))
(check-sat)
(reset-assertions)
(assert (forall ((s Alias)) (= (id s) s)))
(check-sat)
(reset)
(set-logic QF_UF)
(check-sat)
