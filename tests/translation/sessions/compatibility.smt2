; SMT-LIB 2.7 constants, wildcard patterns, and temporary Boolean assumptions.
(set-info :smt-lib-version 2.7)
(set-logic ALL)
(declare-datatype D ((empty) (pair (left Int) (right Int))))
(declare-const x Int)
(declare-const p Bool)
(declare-const |_| Int)
(define-const inc Int (+ x 1))
(define-const gate Bool (and p (> inc x)))
(define-const picked Int (match (pair inc 9) (((pair a _) a) (_ 0))))
(assert (= inc (+ x 1)))
(check-sat-assuming ((and gate (= picked inc))
  (= (match (pair 2 3) (((pair _ _) 9) (_ 0))) 9)))
(check-sat)
(push 1)
(define-const answer Int (match empty (((pair _ _) 0) (_ |_|))))
(check-sat-assuming ((= answer |_|)))
(pop 1)
(check-sat)
(reset-assertions)
(define-const flag Bool true)
(check-sat-assuming ((not flag)))
(check-sat)
(reset)
(set-logic ALL)
(define-const answer Int 7)
(check-sat-assuming ((= answer 7)))
