; Conversions, native aliases, and overflow predicates with bindings and functions.
(set-logic ALL)
(define-sort Word () (_ BitVec 8))
(declare-const n Int)
(declare-const x Word)
(declare-const y Word)
(declare-const p Bool)
(declare-fun f (Word Int Bool) Word)
(declare-fun |BitVec.ofInt| (Int) Word)
(define-fun pack ((n Int)) Word ((_ int_to_bv 8) n))
(define-fun unsigned ((x Word)) Int (bv2nat x))
(assert (= (pack n) ((_ int2bv 8) n)))
(assert (= (unsigned x) (ubv_to_int x)))
(assert (= (sbv_to_int x) (- (ubv_to_int x) 256)))
(assert (and (bvnego x) (bvuaddo x y) (not (bvsaddo x y)) (bvumulo x y) (bvsmulo x y)))
(assert (= (f (ite p (pack n) x) (sbv_to_int y) (bvuaddo x y)) (|BitVec.ofInt| n)))
(assert (let ((n (sbv_to_int x)) (x (pack n))) (= (pack n) x)))
(assert (forall ((BitVec Int))
  (exists ((Int Word)) (= (sbv_to_int Int) (sbv_to_int ((_ int_to_bv 8) BitVec))))))
(check-sat)
