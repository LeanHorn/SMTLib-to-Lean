; Concatenation, slices, extension and repetition through definitions and binders.
(set-logic ALL)
(define-sort Nibble () (_ BitVec 4))
(define-sort Byte () (_ BitVec 8))
(declare-const x Nibble)
(declare-const y (_ BitVec 3))
(declare-const p Bool)
(declare-fun f (Byte) Nibble)
(define-fun pack ((hi Nibble) (lo Nibble)) Byte (concat hi lo))
(assert (= (concat x y #b1) (concat x (concat y #b1))))
(assert (= ((_ extract 7 4) (pack x x)) x))
(assert (= ((_ extract 3 0) (pack x x)) x))
(assert (= ((_ zero_extend 0) x) ((_ sign_extend 0) x)))
(assert (= ((_ sign_extend 4) x)
           (ite (bvslt x #x0) (concat #xf x) ((_ zero_extend 4) x))))
(assert (= ((_ repeat 2) x) (pack x x)))
(assert (= (f ((_ zero_extend 4) (ite p x #x1)))
           ((_ extract 6 3) ((_ repeat 3) x))))
(assert (let ((x ((_ zero_extend 4) x))) (= ((_ extract 7 4) x) #x0)))
(assert (forall ((x Nibble))
  (exists ((x Byte)) (= ((_ extract 3 0) x) #xf))))
(assert (forall ((BitVec Nibble))
  (= ((_ repeat 2) BitVec) (concat BitVec BitVec))))
(check-sat)
