; Variable shift amounts, sign filling, indexed rotations, and composed terms.
(set-logic ALL)
(define-sort Word () (_ BitVec 4))
(declare-const x Word)
(declare-const amount Word)
(declare-const p Bool)
(declare-fun f (Word) Word)
(declare-fun |SMT.bvshl| (Word Word) Word)
(define-fun left ((x Word) (n Word)) Word (bvshl x n))
(define-fun rotate ((x Word)) Word ((_ rotate_left 5) x))
(assert (= (left x amount) (bvlshr x amount)))
(assert (= (bvashr x amount) (ite (bvslt x #x0) #xf #x0)))
(assert (= (rotate x) ((_ rotate_right 3) x)))
(assert (= ((_ rotate_right 4294967295) x) ((_ rotate_right 3) x)))
(assert (= (f (bvshl (ite p x #x1) amount))
           ((_ rotate_left 1) (bvashr x (bvlshr amount #x1)))))
(assert (let ((x (bvshl x amount)) (amount ((_ rotate_right 1) amount)))
  (= (bvlshr x amount) (|SMT.bvshl| x amount))))
(assert (forall ((x Word)) (exists ((amount Word)) (= (bvshl x amount) #x0))))
(assert (forall ((Nat Word) (BitVec Word))
  (= (bvashr Nat BitVec) ((_ rotate_left 0) Nat))))
(check-sat)
