; Symbolic division/remainders composed with functions, bindings, and quantifiers.
(set-logic ALL)
(define-sort Word () (_ BitVec 4))
(declare-const x Word)
(declare-const y Word)
(declare-const p Bool)
(declare-fun f (Word) Word)
(declare-fun |BitVec.smtSDiv| (Word Word) Word)
(define-fun quotient ((x Word) (y Word)) Word (bvudiv x y))
(assert (= (quotient x y) (f x)))
(assert (= (bvurem x y) (bvsrem x y)))
(assert (= (bvsdiv (ite p x y) y) (bvsmod x y)))
(assert (let ((x (bvsdiv x y)) (y (bvurem x y)))
  (= (bvsmod x y) (|BitVec.smtSDiv| x y))))
(assert (forall ((x Word)) (exists ((y Word)) (= (bvudiv x y) x))))
(assert (forall ((BitVec Word) (Int Word))
  (= (bvsrem BitVec Int) (bvurem BitVec Int))))
(check-sat)
