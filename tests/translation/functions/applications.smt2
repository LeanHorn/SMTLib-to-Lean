; Functions and predicates: argument order, nesting, name collisions, and unused parameters.
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun |Int.add| (Int Int) Int)
(declare-fun unused (Int) Int)
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(declare-fun P (Int) Bool)
(declare-fun R (Int Int) Bool)
(declare-fun b (Bool) Bool)
(declare-fun choose (Bool Int) Int)
(declare-fun test (Int Bool) Bool)
(declare-fun |True| (Bool) Int)
(declare-fun unusedBool (Bool Int) Bool)
(assert (= (g x y) (- (f x) (f y))))
(assert (= (f (g y x)) (g (f y) (f x))))
(assert (= (|Int.add| x y) (- x y)))
(assert (=> p (> (f (+ x 1)) (f x))))
(assert (= (g x x) (f (f x))))
(assert (= (f 340282366920938463463374607431768211457) (g 0 (- 1))))
(assert (and (P x) (not (P (f x)))))
(assert (=> (P (g x y)) (R (f x) (g y x))))
(assert (= (R x y) p))
(assert (= (choose p (f x)) (choose (not p) y)))
(assert (test x (and p (P x))))
(assert (= (b (not p)) (or (P y) (R x y))))
(assert (= (b (b true)) (b false)))
(assert (= (choose (= x y) (- x y)) (|True| (=> p (P (f x))))))
(assert (= (test (choose (P (f x)) (g x y)) (b p)) (b (= p (P x)))))
(assert (= (choose (ite p (P x) (not (P y))) (ite (P x) (f y) x))
           (f (ite p x y))))
(check-sat)
(exit)
