; Integer functions: argument order, nesting, name collisions, and an unused function.
(set-logic QF_UFLIA)
(declare-fun f (Int) Int)
(declare-fun g (Int Int) Int)
(declare-fun |Int.add| (Int Int) Int)
(declare-fun unused (Int) Int)
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(assert (= (g x y) (- (f x) (f y))))
(assert (= (f (g y x)) (g (f y) (f x))))
(assert (= (|Int.add| x y) (- x y)))
(assert (=> p (> (f (+ x 1)) (f x))))
(assert (= (g x x) (f (f x))))
(assert (= (f 340282366920938463463374607431768211457) (g 0 (- 1))))
(check-sat)
(exit)
